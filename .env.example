# Sao chép thành .env và điền giá trị. Không commit .env.

# Model tự host (vLLM trên GPU thuê, qua SSH tunnel). Một chuỗi ngẫu nhiên, ví dụ:
#   openssl rand -hex 24
# scripts/gpu/gpu.sh setup gửi giá trị này sang máy thuê làm VLLM_API_KEY.
LOCAL_LLM_API_KEY=
# Token Hugging Face: tải model gated (vd Gemma), đẩy checkpoint/artifact lên HF Hub.
HF_TOKEN=

# Neo4j AuraDB (tuỳ chọn từ 09/11/2026; demo dùng EmbeddedStore).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# API ngoài — KHÔNG dùng từ 09/11/2026 (mọi model tự host); giữ để tham khảo.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
