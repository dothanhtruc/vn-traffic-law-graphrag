# Mẫu khối SSH cho máy GPU thuê (aidev.edu.vn). Chép vào ~/.ssh/config (Windows:
# C:\Users\<tên>\.ssh\config — Git Bash và OpenSSH của Windows dùng chung file này), sửa HostName /
# Port / User theo thông tin máy thuê. KHÔNG commit file đã điền (host/IP/key không vào repo).
#
# Tạo key (một lần):   ssh-keygen -t ed25519 -f ~/.ssh/aidev_ed25519 -C "graphrag-gpu"
# Đăng ký public key (~/.ssh/aidev_ed25519.pub) trên trang quản lý SSH key của aidev trước khi
# tạo máy, hoặc: ssh-copy-id -i ~/.ssh/aidev_ed25519.pub -p <PORT> <USER>@<HOST>
# Kiểm tra:            ssh gpu-aidev nvidia-smi

Host gpu-aidev
    HostName 203.0.113.10          # IP/hostname máy thuê (đổi sau mỗi lần thuê nếu không có IP tĩnh)
    Port 22                        # cổng SSH (máy NAT có thể là cổng khác)
    User root                      # hoặc ubuntu — theo thông tin aidev
    IdentityFile ~/.ssh/aidev_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ExitOnForwardFailure yes
    StrictHostKeyChecking accept-new
    # Máy thuê mới mỗi lần có thể đổi host key cho cùng IP: xoá dòng cũ bằng
    #   ssh-keygen -R "[203.0.113.10]:22"
